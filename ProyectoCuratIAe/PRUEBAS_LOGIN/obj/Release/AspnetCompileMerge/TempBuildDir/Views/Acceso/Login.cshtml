@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <!-- Bootstrap y jQuery -->
    <link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet">
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css">

    <!-- CSS integrado -->
    <style>
        div.main {
            background: #6dd5c1;
            background: -moz-radial-gradient(center, ellipse cover, #6dd5c1 1%, #1c2b5a 100%);
            background: -webkit-gradient(radial, center center, 0px, center center, 100%, color-stop(1%,#6dd5c1), color-stop(100%,#1c2b5a));
            background: -webkit-radial-gradient(center, ellipse cover, #6dd5c1 1%,#1c2b5a 100%);
            background: -o-radial-gradient(center, ellipse cover, #6dd5c1 1%,#1c2b5a 100%);
            background: -ms-radial-gradient(center, ellipse cover, #6dd5c1 1%,#1c2b5a 100%);
            background: radial-gradient(ellipse at center, #6dd5c1 1%,#1c2b5a 100%);
            height: 100vh;
            width: 100%;
        }

        * {
            box-sizing: border-box;
            margin: 0px auto;
        }

        body {
            color: #606468;
            font: 87.5%/1.5em 'Open Sans', sans-serif;
            margin: 0;
        }

        a {
            text-decoration: none;
            transition: all 0.3s ease-in-out;
        }

        input {
            border: none;
            font-family: 'Open Sans', Arial, sans-serif;
            font-size: 14px;
            line-height: 1.5em;
            padding: 0;
            -webkit-appearance: none;
        }

        .clearfix::before,
        .clearfix::after {
            content: " ";
            display: table;
        }

        .clearfix::after {
            clear: both;
        }

        .container {
            left: 50%;
            position: fixed;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        /* ---------- LOGIN ---------- */

        #login form {
            width: 250px;
        }

        #login, .logo {
            display: inline-block;
            width: 40%;
        }

        #login {
            border-right: 1px solid #fff;
            padding: 0px 22px;
            width: 59%;
        }

        .logo {
            color: #fff;
            font-size: 50px;
            line-height: 125px;
        }

        .logo-img {
            max-width: 300px;
            height: auto;
            display: block;
            margin: 0 auto 0px auto;
        }

        #login form span.fa {
            background-color: #fff;
            border-radius: 3px 0px 0px 3px;
            color: #000;
            display: block;
            float: left;
            height: 50px;
            font-size: 24px;
            line-height: 50px;
            text-align: center;
            width: 50px;
        }

        #login form input {
            height: 50px;
        }

        fieldset {
            padding: 0;
            border: 0;
            margin: 0;
        }

        #login form input[type="text"],
        #login form input[type="password"] {
            background-color: #fff;
            border-radius: 0px 3px 3px 0px;
            color: #000;
            margin-bottom: 1em;
            padding: 0 16px;
            width: 200px;
        }

        #login form input[type="submit"] {
            border-radius: 3px;
            background-color: #2c3e50; /* azul primario */
            color: #fff;
            font-weight: bold;
            text-transform: uppercase;
            padding: 8px 10px;
            height: 35px;
            border: none;
            cursor: pointer;
            transition: background 0.3s ease-in-out;
        }

            #login form input[type="submit"]:hover {
                background-color: #ffd300; /* amarillo primario */
                color: #000;
            }

        #login > p {
            text-align: center;
        }

            #login > p span {
                padding-left: 5px;
            }

        .middle {
            display: flex;
            width: 600px;
        }

        /* ---------- LINK REGISTRARSE ---------- */
        a.small-text {
            display: inline-block;
            padding: 6px 12px;
            border: 2px solid #2c3e50;
            border-radius: 6px;
            color: #2c3e50; /* azul oscuro primario */
            font-weight: bold;
            font-size: 13px;
        }

            a.small-text:hover {
                background-color: #ffd300; /* amarillo primario */
                border-color: #ffd300;
                color: #000;
                text-decoration: none;
            }
    </style>
</head>
<body>
    <div class="main">
        <div class="container">
            <center>
                <div class="middle">
                    <div id="login">
                        <!-- Aquí enlazamos el formulario a tu controlador -->
                        <form action="@Url.Action("Login","Acceso")" method="post">
                            <fieldset class="clearfix">

                                <p>
                                    <span class="fa fa-user"></span>
                                    <input type="text" name="Correo" placeholder="Correo" required>
                                </p>

                                <p>
                                    <span class="fa fa-lock"></span>
                                    <input type="password" name="Clave" placeholder="Contraseña" required>
                                </p>

                                @if (ViewData["Mensaje"] != null)
                                {
                                    <div class="alert alert-danger mt-2">
                                        @ViewData["Mensaje"]
                                    </div>
                                }

                                <div>
                                    <span style="width:48%; text-align:left; display:inline-block;">
                                        <a class="small-text" href="@Url.Action("Registrar","Acceso")">Registrarse</a>
                                    </span>
                                    <span style="width:50%; text-align:right; display:inline-block;">
                                        <input type="submit" value="Iniciar Sesión">
                                    </span>
                                </div>
                            </fieldset>
                        </form>
                    </div> <!-- end login -->

                    <div class="logo">
                        <img src="~/Content/Images/CuratIAe_Logo.png" alt="Logo CuratIAe" class="logo-img" />
                        <div class="clearfix"></div>
                    </div>
                </div>
            </center>
        </div>
    </div>
</body>
</html>
