<script>
    // Navegación entre grupos de edad
    document.addEventListener('DOMContentLoaded', function() {
        const ageButtons = document.querySelectorAll('.age-btn');
        const ageContents = document.querySelectorAll('.age-content');

        ageButtons.forEach(button => {
            button.addEventListener('click', function() {
                const targetAge = this.getAttribute('data-age');

                // Remover active de todos los botones y contenidos
                ageButtons.forEach(btn => btn.classList.remove('active'));
                ageContents.forEach(content => content.classList.remove('active'));

                // Agregar active al botón clickeado
                this.classList.add('active');

                // Mostrar el contenido correspondiente
                document.getElementById(`content-${targetAge}`).classList.add('active');

                // Inicializar gráficos para el grupo de edad seleccionado
                initializeCharts(targetAge);
            });
        });

        // Inicializar gráficos para el primer grupo
        initializeCharts('0-2');
    });

    function initializeCharts(ageGroup) {
        const chartConfigs = {
            '0-2': {
                type: 'doughnut',
                data: {
                    labels: ['Lactancia Materna', 'Cereales', 'Frutas/Verduras', 'Proteínas', 'Lácteos'],
                    datasets: [{
                        data: [40, 25, 15, 12, 8],
                        backgroundColor: [
                            '#6dd5c1',
                            '#FFD300',
                            '#4CAF50',
                            '#E53935',
                            '#2196F3'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        title: {
                            display: true,
                            text: 'Distribución Alimentaria Diaria - Norma MINSA 001'
                        }
                    }
                }
            },
            '3-5': {
                type: 'doughnut',
                data: {
                    labels: ['Frutas/Verduras', 'Cereales', 'Proteínas', 'Lácteos', 'Grasas Saludables'],
                    datasets: [{
                        data: [30, 35, 15, 15, 5],
                        backgroundColor: [
                            '#4CAF50',
                            '#FFD300',
                            '#E53935',
                            '#2196F3',
                            '#6dd5c1'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        title: {
                            display: true,
                            text: 'Distribución Alimentaria Diaria - Norma MINSA 002'
                        }
                    }
                }
            }
        };

        const config = chartConfigs[ageGroup];
        if (config) {
            // Destruir gráfico anterior si existe
            const chartElement = document.getElementById(`nutritionChart${ageGroup.replace('-', '')}`);
            if (chartElement) {
                const existingChart = Chart.getChart(chartElement);
                if (existingChart) {
                    existingChart.destroy();
                }

                const ctx = chartElement.getContext('2d');
                new Chart(ctx, config);
            }
        }
    }
</script>