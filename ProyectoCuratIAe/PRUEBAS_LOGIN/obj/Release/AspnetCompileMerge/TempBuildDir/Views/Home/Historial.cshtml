@using System.Linq
@model IEnumerable<PRUEBAS_LOGIN.Models.HistorialMedico>
@{
    ViewBag.Title = "Historial Médico";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="https://fonts.cdnfonts.com/css/legendum" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Legendum', sans-serif;
            background: #f8fafc;
            color: #2c3e50;
            margin: 0;
        }

        /* Hero Section */
        .diagnostico-hero {
            background: linear-gradient(135deg, #6dd5c1 0%, #2c3e50 100%);
            color: white;
            padding: 80px 20px;
            text-align: center;
        }

            .diagnostico-hero h1 {
                font-size: 3rem;
                margin-bottom: 20px;
                text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            }

            .diagnostico-hero p {
                font-size: 1.2rem;
                max-width: 600px;
                margin: 0 auto;
                opacity: 0.9;
            }

        /* Contenedor principal */
        .historial-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Filtros */
        .filtros-section {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }

        .filtros-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .filtro-group {
            display: flex;
            flex-direction: column;
        }

            .filtro-group label {
                font-weight: 600;
                margin-bottom: 8px;
                color: #2c3e50;
            }

            .filtro-group select,
            .filtro-group input {
                padding: 12px;
                border: 2px solid #e0e6ed;
                border-radius: 8px;
                font-family: 'Legendum', sans-serif;
                transition: border-color 0.3s;
            }

                .filtro-group select:focus,
                .filtro-group input:focus {
                    outline: none;
                    border-color: #6dd5c1;
                }

        .busqueda-avanzada {
            display: flex;
            gap: 15px;
        }

            .busqueda-avanzada input {
                flex: 1;
            }

        .btn-buscar {
            background: #6dd5c1;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Legendum', sans-serif;
            font-weight: 600;
            transition: background 0.3s;
        }

            .btn-buscar:hover {
                background: #5bc4b0;
            }

        /* Tarjetas de historial */
        .historial-grid {
            display: grid;
            gap: 25px;
        }

        .historial-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            padding: 30px;
            transition: transform 0.3s, box-shadow 0.3s;
            border-left: 5px solid #6dd5c1;
        }

            .historial-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            }

            .historial-card.emergencia {
                border-left-color: #E53935;
            }

            .historial-card.consulta {
                border-left-color: #6dd5c1;
            }

            .historial-card.diagnostico {
                border-left-color: #FFD300;
            }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .fecha {
            background: #f8fafc;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            color: #2c3e50;
        }

        .tipo-consulta {
            background: #6dd5c1;
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

            .tipo-consulta.emergencia {
                background: #E53935;
                color: white; 
            }

            .tipo-consulta.diagnostico {
                background: #FFD300;
                color: #2c3e50;
            }

        .card-content h3 {
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 1.3rem;
        }

        .diagnostico-info {
            background: #f8fafc;
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
        }

            .diagnostico-info p {
                margin: 8px 0;
                color: #2c3e50;
            }

        .medicamentos {
            margin: 15px 0;
        }

        .medicamento-tag {
            display: inline-block;
            background: #e3f2fd;
            color: #1976d2;
            padding: 5px 12px;
            border-radius: 15px;
            margin: 5px 5px 5px 0;
            font-size: 0.9rem;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #e0e6ed;
        }

        .medico-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .medico-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #6dd5c1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
        }

        .acciones button {
            background: none;
            border: 2px solid #6dd5c1;
            color: #6dd5c1;
            padding: 8px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-family: 'Legendum', sans-serif;
            transition: all 0.3s;
        }

            .acciones button:hover {
                background: #6dd5c1;
                color: white;
            }

        .no-records {
            text-align: center;
            padding: 40px;
            background: white;
            border-radius: 15px;
            grid-column: 1 / -1;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .diagnostico-hero h1 {
                font-size: 2.2rem;
            }

            .card-header {
                flex-direction: column;
                gap: 10px;
            }

            .card-footer {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }

            .busqueda-avanzada {
                flex-direction: column;
            }
        }
    </style>
}

<section class="diagnostico-hero">
    <h1>Historial Médico Digital</h1>
    <p>Accede a tu historial completo de consultas, diagnósticos y tratamientos en un solo lugar</p>
</section>

<div class="historial-container">
    <!-- Filtros -->
    <section class="filtros-section">
        <div class="filtros-grid">
            <div class="filtro-group">
                <label for="fecha-desde">Desde:</label>
                <input type="date" id="fecha-desde">
            </div>
            <div class="filtro-group">
                <label for="fecha-hasta">Hasta:</label>
                <input type="date" id="fecha-hasta">
            </div>
            <div class="filtro-group">
                <label for="tipo-consulta">Tipo de Consulta:</label>
                <select id="tipo-consulta">
                    <option value="todas">Todas</option>
                    <option value="consulta">Consulta General</option>
                    <option value="emergencia">Emergencia</option>
                    <option value="diagnostico">Diagnóstico IA</option>
                </select>
            </div>
            <div class="filtro-group">
                <label for="especialidad">Especialidad:</label>
                <select id="especialidad">
                    <option value="todas">Todas</option>
                    <option value="medicina-general">Medicina General</option>
                    <option value="cardiologia">Cardiología</option>
                    <option value="pediatria">Pediatría</option>
                </select>
            </div>
        </div>

        <div class="busqueda-avanzada">
            <input type="text" id="busqueda" placeholder="Buscar en diagnósticos, síntomas, medicamentos...">
            <button class="btn-buscar">
                <i class="fas fa-search"></i> Buscar
            </button>
        </div>
    </section>

    <!-- Grid de Historial -->
    <section class="historial-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="historial-card @item.TipoConsulta.ToLower()">
                    <div class="card-header">
                        <span class="fecha">@item.Fecha.ToString("dd MMM yyyy - hh:mm tt")</span>
                        <span class="tipo-consulta @item.TipoConsulta.ToLower()">@item.TipoConsulta</span>
                    </div>
                    <div class="card-content">
                        <h3>@item.Titulo</h3>
                        <div class="diagnostico-info">
                            <p><strong>Síntomas reportados:</strong> @item.Sintomas</p>
                            <p><strong>Diagnóstico:</strong> @item.Diagnostico</p>
                            <p><strong>Recomendaciones:</strong> @item.Recomendaciones</p>
                        </div>
                        <div class="medicamentos">
                            <strong>Medicamentos recetados:</strong>
                            @if (!string.IsNullOrEmpty(item.Medicamentos))
                            {
                                foreach (var med in item.Medicamentos.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="medicamento-tag">@med.Trim()</span>
                                }
                            }
                            else
                            {
                                <span>No se recetaron medicamentos</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="medico-info">
                            <div class="medico-avatar">
                                @if (!string.IsNullOrEmpty(item.MedicoNombre) && item.MedicoNombre.Length >= 2)
                                {
                                    @item.MedicoNombre.Substring(0, 2).ToUpper()
                                }
                                else
                                {
                                    @:DR
                                }
                            </div>
                            <div>
                                <strong>@item.MedicoNombre</strong>
                                <p>@item.Especialidad</p>
                            </div>
                        </div>
                        <div class="acciones">
                            <button><i class="fas fa-download"></i> Descargar PDF</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-records">
                <i class="fas fa-clipboard-list" style="font-size: 3rem; color: #6dd5c1; margin-bottom: 15px;"></i>
                <h3>No hay registros en el historial médico</h3>
                <p>No se encontraron consultas, diagnósticos o emergencias registradas.</p>
            </div>
        }
    </section>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnBuscar = document.querySelector('.btn-buscar');
            const inputBusqueda = document.getElementById('busqueda');

            btnBuscar.addEventListener('click', function () {
                const termino = inputBusqueda.value.toLowerCase();
                filtrarHistorial(termino);
            });

            function filtrarHistorial(termino) {
                const cards = document.querySelectorAll('.historial-card');
                cards.forEach(card => {
                    const textoCard = card.textContent.toLowerCase();
                    if (textoCard.includes(termino) || termino === '') {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }
        });
    </script>
}