                            </div>
                            <div class="detail-item">
                                <strong>Servicios Ofrecidos</strong>
                                <div>${app.services}</div>
                            </div>
                        </div>

                        <div class="info-card">
                            <h3><i class="fas fa-user-md"></i> Personal Médico</h3>
                            <div class="detail-item">
                                <strong>Médico Responsable</strong>
                                <div>${app.doctor}</div>
                            </div>
                            <div class="detail-item">
                                <strong>Cargo</strong>
                                <div>${app.title}</div>
                            </div>
                            <div class="detail-item">
                                <strong>Teléfono de Contacto</strong>
                                <div>${app.phone}</div>
                            </div>
                        </div>
                    </div>

                    <div class="clinic-info">
                        <div class="info-card">
                            <h3><i class="fas fa-map-marker-alt"></i> Ubicación y Horario</h3>
                            <div class="detail-item">
                                <strong>Comunidad</strong>
                                <div>${app.community}</div>
                            </div>
                            <div class="detail-item">
                                <strong>Dirección Exacta</strong>
                                <div>${app.address}</div>
                            </div>
                            <div class="detail-item">
                                <strong>Horario de Atención</strong>
                                <div>${app.time}</div>
                            </div>
                        </div>

                        <div class="info-card">
                            <h3><i class="fas fa-clipboard-list"></i> Información Adicional</h3>
                            <div class="detail-item">
                                <strong>Notas Importantes</strong>
                                <div>${app.notes}</div>
                            </div>
                            <div class="detail-item">
                                <strong>Requisitos</strong>
                                <div>Llevar cédula de identidad y cartilla de salud si posee</div>
                            </div>
                            <div class="detail-item">
                                <strong>Costo</strong>
                                <div><strong style="color: var(--primario);">Atención completamente gratuita</strong></div>
                            </div>
                        </div>
                    </div>

                    <div style="background: var(--fondo); padding: 1.5rem; border-radius: 10px; margin-top: 1rem;">
                        <h3 style="color: var(--primario); margin-bottom: 1rem;"><i class="fas fa-shield-alt"></i> Aval MINSA</h3>
                        <p>Esta atención médica está oficialmente avalada por el Ministerio de Salud de Nicaragua. Todos los medicamentos y procedimientos son gratuitos.</p>
                    </div>
                `;
        });

        modalBody.innerHTML = html;
        modal.style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('appointment-modal').style.display = 'none';
    }

    function formatDate(dateString) {
        const date = new Date(dateString);
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        return date.toLocaleDateString('es-ES', options);
    }
