    let currentDate = new Date();
    let currentFilter = 'all';
    let currentView = 'calendar';

    document.addEventListener('DOMContentLoaded', function () {
        renderCalendar(currentDate);
        renderListView(currentDate);
        setupEventListeners();
    });

    function setupEventListeners() {
        // Navegación de meses
        document.getElementById('prev-month').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar(currentDate);
            renderListView(currentDate);
        });

        document.getElementById('next-month').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar(currentDate);
            renderListView(currentDate);
        });

        // Filtros
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentFilter = this.getAttribute('data-filter');
                renderCalendar(currentDate);
                renderListView(currentDate);
            });
        });

        // Cambio de vista
        document.querySelectorAll('.view-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentView = this.getAttribute('data-view');

                document.querySelectorAll('.view-container').forEach(view => {
                    view.classList.remove('active');
                });
                document.getElementById(currentView + '-view').classList.add('active');
            });
        });

        // Modal
        document.getElementById('close-modal').addEventListener('click', closeModal);
        document.getElementById('appointment-modal').addEventListener('click', function (e) {
            if (e.target === this) closeModal();
        });
    }

    function renderCalendar(date) {
        const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        document.getElementById('current-month').textContent = `${monthNames[date.getMonth()]} ${date.getFullYear()}`;

        const calendarDays = document.getElementById('calendar-days');
        calendarDays.innerHTML = '';

        const firstDay = new Date(date.getFullYear(), date.getMonth(), 1);
        const lastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0);
        const firstDayIndex = firstDay.getDay();

        // Días del mes anterior
        const prevMonthLastDay = new Date(date.getFullYear(), date.getMonth(), 0).getDate();
        for (let i = firstDayIndex; i > 0; i--) {
            const dayElement = createCalendarDay(prevMonthLastDay - i + 1, true);
            calendarDays.appendChild(dayElement);
        }

        // Días del mes actual
        for (let i = 1; i <= lastDay.getDate(); i++) {
            const dayElement = createCalendarDay(i, false, date);
            calendarDays.appendChild(dayElement);
        }

        // Días del siguiente mes
        const totalCells = 42;
        const remainingCells = totalCells - (firstDayIndex + lastDay.getDate());
        for (let i = 1; i <= remainingCells; i++) {
            const dayElement = createCalendarDay(i, true);
            calendarDays.appendChild(dayElement);
        }
    }

    function createCalendarDay(dayNumber, isOtherMonth, date = null) {
        const dayElement = document.createElement('div');
        dayElement.className = 'calendar-day';

        if (isOtherMonth) {
            dayElement.classList.add('other-month');
        }

        dayElement.innerHTML = `<div style="font-weight: bold; margin-bottom: 5px;">${dayNumber}</div>`;

        if (!isOtherMonth && date) {
            const currentDateStr = `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${dayNumber.toString().padStart(2, '0')}`;
            const dayAppointments = medicalAppointments.filter(app => app.date === currentDateStr);
            const filteredAppointments = currentFilter === 'all' ? dayAppointments : dayAppointments.filter(app => app.specialty === currentFilter);

            if (filteredAppointments.length > 0) {
                dayElement.classList.add('has-appointments');

                const countBadge = document.createElement('div');
                countBadge.className = 'appointment-count';
                countBadge.textContent = filteredAppointments.length;
                dayElement.appendChild(countBadge);

                dayElement.addEventListener('click', () => showAppointmentDetails(filteredAppointments, currentDateStr));
            }
        }

        return dayElement;
    }

    function renderListView(date) {
        const appointmentList = document.getElementById('appointment-list');
        appointmentList.innerHTML = '';

        const monthStart = new Date(date.getFullYear(), date.getMonth(), 1);
        const monthEnd = new Date(date.getFullYear(), date.getMonth() + 1, 0);

        const monthAppointments = medicalAppointments.filter(app => {
            const appDate = new Date(app.date);
            return appDate >= monthStart && appDate <= monthEnd;
        });

        const filteredAppointments = currentFilter === 'all' ? monthAppointments : monthAppointments.filter(app => app.specialty === currentFilter);

        filteredAppointments.sort((a, b) => new Date(a.date) - new Date(b.date));

        filteredAppointments.forEach(app => {
            const item = document.createElement('div');
            item.className = 'appointment-item';
            item.innerHTML = `
                    <div>
                        <strong>${formatDate(app.date)}</strong><br>
                        <small>${app.time}</small>
                    </div>
                    <div>${app.unit}</div>
                    <div><span class="specialty-badge">${app.specialty}</span></div>
                    <div>${app.community}</div>
                `;
            item.addEventListener('click', () => showAppointmentDetails([app], app.date));
            appointmentList.appendChild(item);
        });

        if (filteredAppointments.length === 0) {
            appointmentList.innerHTML = '<div style="padding: 2rem; text-align: center; color: #666;">No hay clínicas móviles programadas para este mes con el filtro seleccionado</div>';
        }
    }

