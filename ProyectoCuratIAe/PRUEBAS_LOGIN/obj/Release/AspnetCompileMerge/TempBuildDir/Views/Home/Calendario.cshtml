@{
    ViewBag.Title = "Calendario de Clínicas Móviles MINSA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="https://fonts.cdnfonts.com/css/legendum" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primario: #6dd5c1;
            --secundario: #FFD300;
            --terciario: #E53935;
            --texto: #2c3e50;
            --fondo: #f8fafc;
            --borde: #e0e6ed;
            --exito: #4CAF50;
            --alerta: #FF9800;
        }

        /* Ajuste del main para el header fijo */
        main {
            padding-top: 120px;
        }

        /* Hero Section MINSA */
        .calendar-hero {
            background: linear-gradient(135deg, var(--primario) 0%, var(--secundario) 100%);
            color: #ffffff;
            padding: 4rem 2rem;
            text-align: center;
            position: relative;
        }

        .hero-content {
            max-width: 1000px;
            margin: 0 auto;
        }

        .hero-title {
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            opacity: 0.95;
            margin-bottom: 2rem;
        }

        .minsa-info {
            background: rgba(255,255,255,0.1);
            padding: 1.5rem;
            border-radius: 15px;
            margin-top: 2rem;
        }

        /* Main Content */
        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        /* Panel de Control Mejorado */
        .control-panel {
            background: #ffffff;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            padding: 2rem;
            margin-bottom: 2rem;
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 2rem;
            align-items: center;
        }

        .month-navigation {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .nav-btn {
            width: 45px;
            height: 45px;
            background: var(--primario);
            color: #ffffff;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .nav-btn:hover {
                background: var(--secundario);
                transform: scale(1.1);
            }

        .current-month {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--texto);
            min-width: 200px;
            text-align: center;
        }

        .filter-section {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .filter-btn {
            background: #ffffff;
            border: 2px solid var(--borde);
            padding: 0.7rem 1.2rem;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Legendum', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
        }

            .filter-btn.active {
                background: var(--primario);
                color: #ffffff;
                border-color: var(--primario);
            }

        .view-toggle {
            display: flex;
            background: var(--fondo);
            border-radius: 12px;
            padding: 0.3rem;
        }

        .view-btn {
            padding: 0.7rem 1.2rem;
            border: none;
            background: transparent;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-family: 'Legendum', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
        }

            .view-btn.active {
                background: var(--primario);
                color: #ffffff;
            }

        /* Vistas: Calendario y Lista */
        .view-container {
            display: none;
        }

            .view-container.active {
                display: block;
                animation: fadeIn 0.5s ease;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Vista Calendario */
        .calendar-container {
            background: #ffffff;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .calendar-header {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            background: var(--primario);
            color: #ffffff;
            text-align: center;
            font-weight: 600;
        }

            .calendar-header div {
                padding: 1.2rem 0;
                border-right: 1px solid rgba(255,255,255,0.1);
            }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            grid-auto-rows: 120px;
            gap: 1px;
            background: var(--borde);
        }

        .calendar-day {
            background: #ffffff;
            padding: 0.8rem;
            position: relative;
            transition: all 0.3s ease;
            border: 1px solid var(--borde);
        }

            .calendar-day.other-month {
                color: #bdc3c7;
                background: #fafafa;
            }

            .calendar-day.has-appointments {
                background: linear-gradient(135deg, #e8f5e8 0%, #ffffff 100%);
                border-left: 4px solid var(--primario);
                cursor: pointer;
            }

        .appointment-count {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            background: var(--terciario);
            color: #ffffff;
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Vista Lista */
        .list-container {
            background: #ffffff;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .list-header {
            background: var(--primario);
            color: #ffffff;
            padding: 1.5rem 2rem;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            font-weight: 600;
        }

        .appointment-list {
            max-height: 600px;
            overflow-y: auto;
        }

        .appointment-item {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--borde);
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .appointment-item:hover {
                background: #f8f9fa;
                transform: translateX(5px);
            }

            .appointment-item:last-child {
                border-bottom: none;
            }

        .specialty-badge {
            background: var(--secundario);
            color: var(--texto);
            padding: 0.3rem 0.8rem;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            width: fit-content;
        }

        /* Modal MINSA */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 3000;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .modal-content {
            background: #ffffff;
            width: 100%;
            max-width: 800px;
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
            overflow: hidden;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header {
            background: linear-gradient(135deg, var(--primario) 0%, var(--secundario) 100%);
            color: #ffffff;
            padding: 2rem;
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(255,255,255,0.2);
            border: none;
            color: #ffffff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

            .modal-close:hover {
                background: rgba(255,255,255,0.3);
            }

        .modal-body {
            padding: 2rem;
        }

        .clinic-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .info-card {
            background: var(--fondo);
            padding: 1.5rem;
            border-radius: 12px;
            border-left: 4px solid var(--primario);
        }

            .info-card h3 {
                color: var(--primario);
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .detail-item {
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--borde);
        }

            .detail-item:last-child {
                border-bottom: none;
                margin-bottom: 0;
            }

            .detail-item strong {
                color: var(--texto);
                display: block;
                margin-bottom: 0.3rem;
            }

        /* Footer MINSA */
        .main-footer {
            background: var(--texto);
            color: #ffffff;
            text-align: center;
            padding: 2rem;
            margin-top: 3rem;
        }

        .minsa-contact {
            background: var(--primario);
            padding: 2rem;
            margin-top: 2rem;
            border-radius: 10px;
        }

        /* Responsive */
        @@media (max-width: 1024px) {
            .control-panel {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .clinic-info {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            main {
                padding-top: 140px;
            }

            .calendar-grid {
                grid-auto-rows: 80px;
            }

            .list-header, .appointment-item {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .hero-title {
                font-size: 2.2rem;
            }

            .control-panel {
                padding: 1.5rem;
            }

            .filter-section {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 480px) {
            .hero-title {
                font-size: 1.8rem;
            }

            .current-month {
                font-size: 1.2rem;
                min-width: 150px;
            }

            .calendar-header div {
                padding: 0.8rem 0;
                font-size: 0.9rem;
            }

            .modal-body {
                padding: 1rem;
            }
        }
    </style>
}

<!-- Hero Section MINSA -->
<section class="calendar-hero">
    <div class="hero-content">
        <h1 class="hero-title"><i class="fas fa-clinic-medical"></i> Clínicas Móviles MINSA</h1>
        <p class="hero-subtitle">Programación oficial de atenciones médicas - Municipio de Estelí, Nicaragua</p>

        <div class="minsa-info">
            <p><i class="fas fa-info-circle"></i> <strong>Información Oficial:</strong> Todas las atenciones son gratuitas y avaladas por el Ministerio de Salud de Nicaragua</p>
        </div>
    </div>
</section>

<!-- Main Content -->
<div class="main-container">
    <!-- Panel de Control -->
    <div class="control-panel">
        <div class="month-navigation">
            <button class="nav-btn" id="prev-month">
                <i class="fas fa-chevron-left"></i>
            </button>
            <div class="current-month" id="current-month">Cargando...</div>
            <button class="nav-btn" id="next-month">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

        <div class="filter-section">
            <button class="filter-btn active" data-filter="all">Todas las Especialidades</button>
            <button class="filter-btn" data-filter="Medicina General">Medicina General</button>
            <button class="filter-btn" data-filter="Pediatría">Pediatría</button>
            <button class="filter-btn" data-filter="Ginecología">Ginecología</button>
            <button class="filter-btn" data-filter="Odontología">Odontología</button>
        </div>

        <div class="view-toggle">
            <button class="view-btn active" data-view="calendar">
                <i class="fas fa-calendar-alt"></i> Vista Calendario
            </button>
            <button class="view-btn" data-view="list">
                <i class="fas fa-list"></i> Vista Lista
            </button>
        </div>
    </div>

    <!-- Vista Calendario -->
    <div class="view-container active" id="calendar-view">
        <div class="calendar-container">
            <div class="calendar-header">
                <div>Dom</div>
                <div>Lun</div>
                <div>Mar</div>
                <div>Mié</div>
                <div>Jue</div>
                <div>Vie</div>
                <div>Sáb</div>
            </div>
            <div class="calendar-grid" id="calendar-days"></div>
        </div>
    </div>

    <!-- Vista Lista -->
    <div class="view-container" id="list-view">
        <div class="list-container">
            <div class="list-header">
                <div>Fecha y Hora</div>
                <div>Clínica Móvil</div>
                <div>Especialidad</div>
                <div>Ubicación</div>
            </div>
            <div class="appointment-list" id="appointment-list">
                <!-- Lista generada dinámicamente -->
            </div>
        </div>
    </div>
</div>

<!-- Modal MINSA -->
<div class="modal-overlay" id="appointment-modal">
    <div class="modal-content">
        <div class="modal-header">
            <button class="modal-close" id="close-modal">
                <i class="fas fa-times"></i>
            </button>
            <h2 id="modal-title">Detalles de la Clínica Móvil</h2>
            <p id="modal-subtitle">Información completa de la atención médica</p>
        </div>
        <div class="modal-body" id="modal-body">
            <!-- Contenido dinámico -->
        </div>
    </div>
</div>

<!-- Footer MINSA -->
<footer class="main-footer">
    <div class="footer-content">
        <p>© 2025 CuratIAe · Sistema oficial en colaboración con el Ministerio de Salud de Nicaragua</p>

        <div class="minsa-contact">
            <h3><i class="fas fa-phone-alt"></i> Contacto MINSA Estelí</h3>
            <p>Teléfono: (505) 2713-2222 · Dirección: Costado Norte del Parque Central, Estelí, Nicaragua</p>
            <p>Horario de atención: Lunes a Viernes 7:00 AM - 5:00 PM</p>
            <p>Para emergencias médicas: Línea gratuita 128</p>
        </div>
    </div>
</footer>

