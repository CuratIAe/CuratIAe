<script>
    // Funcionalidad de filtros
    document.addEventListener('DOMContentLoaded', function() {
        const filterButtons = document.querySelectorAll('.filter-btn');
        const vaccinationCards = document.querySelectorAll('.vaccination-card');
        const monthFilter = document.getElementById('month-filter');
        const departmentFilter = document.getElementById('department-filter');
        const searchInput = document.querySelector('.search-input[type="text"]');

        // Filtros por tipo
        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Remover clase active de todos los botones
                filterButtons.forEach(btn => btn.classList.remove('active'));
                // Agregar clase active al botón clickeado
                this.classList.add('active');

                const filterValue = this.getAttribute('data-filter');

                vaccinationCards.forEach(card => {
                    if (filterValue === 'all') {
                        card.style.display = 'block';
                    } else {
                        if (card.getAttribute('data-type').includes(filterValue)) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    }
                });
            });
        });

        // Filtros por mes y departamento
        function applyFilters() {
            const monthValue = monthFilter.value;
            const departmentValue = departmentFilter.value;
            const searchValue = searchInput.value.toLowerCase();

            vaccinationCards.forEach(card => {
                const cardMonth = card.getAttribute('data-month');
                const cardDepartment = card.getAttribute('data-department');
                const cardText = card.textContent.toLowerCase();

                const monthMatch = monthValue === '' || cardMonth === monthValue;
                const departmentMatch = departmentValue === '' || cardDepartment === departmentValue;
                const searchMatch = cardText.includes(searchValue);

                if (monthMatch && departmentMatch && searchMatch) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        monthFilter.addEventListener('change', applyFilters);
        departmentFilter.addEventListener('change', applyFilters);
        searchInput.addEventListener('input', applyFilters);

        // Simular clic en el primer botón de filtro para mostrar todas las tarjetas
        document.querySelector('.filter-btn[data-filter="all"]').click();

        // Funcionalidad de botones
        document.querySelectorAll('.btn-primary').forEach(button => {
            button.addEventListener('click', function() {
                const card = this.closest('.vaccination-card');
                const title = card.querySelector('.card-title').textContent;
                const date = card.querySelector('.card-date').textContent;
                const location = card.querySelector('.card-location span').textContent;

                alert(`Información de la jornada:\n\n${title}\n${date}\n${location}\n\nPara agendar su cita, visite el centro de salud más cercano o llame al (505) 2254-7884`);
            });
        });
    });
</script>