@{
        Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - CuratIAe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Sección de estilos específica de la vista -->
    @RenderSection("styles", required: false)

    <style>
        /* ===== Reset básico ===== */
        html, body {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        /* ===== Menú ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            z-index: 100;
        }

        nav {
            max-width: 1200px;
            margin: 0 auto;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Logo */
        .navbar-logo img {
            height: 80px;
            max-width: 200px;
            object-fit: contain;
            display: block;
        }

        /* Menú links */
        nav ul {
            display: flex;
            gap: 20px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

            nav ul li a {
                text-decoration: none;
                color: #333;
                transition: color 0.3s;
            }

                nav ul li a:hover {
                    color: #2563eb;
                }

        /* Ajuste main */
        main {
            padding-top: 80px;
        }

        /* Hero */
        .hero {
            text-align: center;
            padding: 80px 20px;
            background: linear-gradient(to right, #3b82f6, #6366f1);
            color: #fff;
        }

            .hero h2 {
                font-size: 2.5rem;
                margin-bottom: 15px;
            }

            .hero p {
                font-size: 1.1rem;
            }

        /* Grid con cards */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 60px auto;
            padding: 0 20px;
        }

        .card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
            text-decoration: none;
            color: inherit;
        }

            .card:hover {
                transform: scale(1.05);
                box-shadow: 0 8px 18px rgba(0,0,0,0.2);
            }

        .icon {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .consulta {
            color: #2563eb;
        }

        .emergencia {
            color: #dc2626;
        }

        .diagnostico {
            color: #16a34a;
        }

        .info {
            color: #7c3aed;
        }

        /* Footer */
        footer {
            background: #1f2937;
            color: #d1d5db;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }
    </style>
</head>
<body>
    <!-- Menú principal -->
    <header>
        <nav>
            <a href="@Url.Action("Index", "Home")" class="navbar-logo">
                <img src="~/Content/Images/CuratIAe_Logo.png" alt="CuratIAe" />
            </a>
            <ul>
                <li>@Html.ActionLink("Inicio", "Index", "Home")</li>
                <li>@Html.ActionLink("Nosotros", "About", "Home")</li>
                @*<li>@Html.ActionLink("Contáctanos", "Contact", "Home")</li>*@
                <li>@Html.ActionLink("Dr.CuratIAe", "Chat", "Home")</li>
                <li>@Html.ActionLink("Geolocalización", "Geo", "Home")</li>
                <li>@Html.ActionLink("Historial Médico", "Historial", "Home")</li>
                <li>@Html.ActionLink("Registro / Inicio de Sesión", "Login", "Acceso")</li>
            </ul>
        </nav>
    </header>

    <!-- Contenido dinámico -->
    <main>
        @RenderBody()
    </main>

    <!-- Pie de página -->
    <footer>
        <p>&copy; @DateTime.Now.Year - CuratIAe</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>


